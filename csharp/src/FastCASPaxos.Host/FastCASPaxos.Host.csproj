<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuildAdminConsole Condition="'$(BuildAdminConsole)' == ''">true</BuildAdminConsole>
    <AdminRoot>$(MSBuildProjectDirectory)\..\..\..\admin</AdminRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FastCASPaxos.Grpc\FastCASPaxos.Grpc.csproj" />
    <ProjectReference Include="..\FastCASPaxos.Rest\FastCASPaxos.Rest.csproj" />
    <ProjectReference Include="..\FastCASPaxos.Sqlite\FastCASPaxos.Sqlite.csproj" />
  </ItemGroup>
  <Target Name="BuildAdminAssets" BeforeTargets="PrepareForBuild" Condition="'$(BuildAdminConsole)' == 'true'">
    <!-- Both target frameworks share one build request for node_modules and dist. -->
    <MSBuild Projects="$(AdminRoot)\build.proj" Targets="Build"
             RemoveProperties="TargetFramework;TargetFrameworks" />
  </Target>
  <Target Name="CopyAdminAssets" AfterTargets="Build"
          Condition="'$(BuildAdminConsole)' == 'true' And '$(TargetFramework)' != ''">
    <ItemGroup>
      <AdminAsset Include="$(AdminRoot)\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AdminAsset)" DestinationFiles="@(AdminAsset->'$(OutDir)wwwroot\admin\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishAdminAssets" AfterTargets="ComputeFilesToPublish" Condition="'$(BuildAdminConsole)' == 'true'">
    <ItemGroup>
      <AdminPublishAsset Include="$(AdminRoot)\dist\**\*" />
      <ResolvedFileToPublish Include="@(AdminPublishAsset)">
        <RelativePath>wwwroot\admin\%(AdminPublishAsset.RecursiveDir)%(AdminPublishAsset.Filename)%(AdminPublishAsset.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
